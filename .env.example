# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored — the real values never go to GitHub.
#
# Used by:
# - run_local.ps1 / run_cloud.ps1  (pass the key via --dart-define)
# - android/app/build.gradle.kts   (injects the Maps key into AndroidManifest.xml)
# - web/env.js generation          (used by web/index.html)

GOOGLE_MAPS_API_KEY=PASTE_YOUR_GOOGLE_MAPS_API_KEY_HERE
